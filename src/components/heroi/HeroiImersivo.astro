---
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";

interface Props {
  rotulo: string;
  h1: string;
  intro: string;
  acaoTexto: string;
  acaoHref: string;
  foto: ImageMetadata;
}

const { rotulo, h1, intro, acaoTexto, acaoHref, foto } = Astro.props;

const grande = await getImage({ src: foto, format: "avif", width: 1800, quality: 58 });
const pequena = await getImage({ src: foto, format: "avif", width: 820, quality: 58 });
---
<section
  class="abertura-imersiva em-escuro"
  aria-labelledby="h1"
  style={`--foto-g: url(${grande.src}); --foto-p: url(${pequena.src});`}
>
  <div class="ai-dentro">
    <p class="ai-rotulo">{rotulo}</p>
    <h1 id="h1" set:html={h1} />
    <p class="ai-intro">{intro}</p>
    <div class="ai-acoes">
      <a class="acao acao-clara" href={acaoHref}>{acaoTexto}</a>
      <a class="acao-2 acao-2-clara" href="#escopo">
        Ver o que entra e o que não entra
      </a>
    </div>
  </div>
</section>

<style>
  .abertura-imersiva {
    display: grid;
    place-content: center;
    min-block-size: 86svh;
    padding-block: var(--e-24);
    padding-inline: var(--goteira);
    text-align: center;
    color: var(--cor-papel);

    --foto-g: none;
    --foto-p: none;
    background:
      radial-gradient(
        64% 60% at 50% 50%,
        rgb(10 19 36 / 0.42),
        rgb(10 19 36 / 0) 78%
      ),
      linear-gradient(rgb(20 37 68 / 0.62), rgb(20 37 68 / 0.62)),
      var(--foto-p),
      var(--cor-escuro);
    background-size: auto, auto, cover, auto;
    background-position: center;
  }
  @media (min-width: 48rem) {
    .abertura-imersiva {
      background-image: radial-gradient(
          64% 60% at 50% 50%,
          rgb(10 19 36 / 0.42),
          rgb(10 19 36 / 0) 78%
        ),
        linear-gradient(rgb(20 37 68 / 0.62), rgb(20 37 68 / 0.62)),
        var(--foto-g);
    }
  }

  .ai-dentro {
    max-inline-size: 46rem;
    margin-inline: auto;
  }

  .ai-rotulo {
    font-size: var(--t-rotulo);
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--cor-acento-sobre-escuro);
    margin-block-end: var(--e-8);
  }

  h1 {
    font-size: clamp(1.875rem, 1.1rem + 3vw, 3.25rem);
    letter-spacing: -0.03em;
    line-height: 1.04;
    margin-block-end: var(--e-8);
  }

  .ai-intro {
    font-size: clamp(1.0625rem, 1rem + 0.4vw, 1.25rem);
    color: var(--cor-papel);
    max-inline-size: 54ch;
    margin-inline: auto;
    margin-block-end: var(--e-12);
  }

  .ai-acoes {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-4);
    justify-content: center;
  }

  @media (prefers-reduced-motion: no-preference) {
    .ai-dentro > * {
      animation: ai-assentar calc(var(--m-lento) * 1.3) var(--m-saida) both;
    }
    .ai-dentro > :nth-child(2) {
      animation-delay: 90ms;
    }
    .ai-dentro > :nth-child(3) {
      animation-delay: 180ms;
    }
    .ai-dentro > :nth-child(4) {
      animation-delay: 270ms;
    }
  }
  @keyframes ai-assentar {
    from {
      translate: 0 0.75rem;
    }
  }

  .ai-acoes :global(.acao-2-clara) {
    color: var(--cor-papel);
  }
</style>
